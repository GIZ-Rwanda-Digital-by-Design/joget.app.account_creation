    "binder": {
        "className": "org.joget.marketplace.SqlDataListBinder",
        "properties": {
            "primary_key": "id",
            "sql": "SELECT \n    u.*,\n    e.organizationId,\n    o.name as organizationName,\n    s.c_sectorName\nFROM \n    dir_user u\nLEFT JOIN \n    dir_employment e ON u.username = e.userid\nLEFT JOIN \n    dir_organization o ON e.organizationId = o.id\nLEFT JOIN\n    app_fd_map_sec_and_inst m ON o.id = m.c_institutionName\nLEFT JOIN\n    app_fd_sector_creation s ON m.c_sectorName = s.id\nWHERE \n    1;"
        }
