                {
                    "className": "org.joget.apps.form.lib.CustomHTML",
                    "properties": {
                        "requiredSanitize": "",
                        "autoPopulate": "",
                        "label": "",
                        "id": "field4",
                        "value": "<div id=\"pwMatchMsg\" style=\"font-size:12px; margin-top:6px;\"><\/div>\n<script>\n  $(function () {\n    // 1) Get the real form\n    const $form = $('#resetPassword').length ? $('#resetPassword') : $('form').first();\n\n    // 2) Grab the first two password inputs inside the form (New + Retype)\n    const $pw = $form.find('input[type=\"password\"]');\n    const $pass = $pw.eq(0);   // New password\n    const $re   = $pw.eq(1);   // Retype password\n\n    // 3) Find a submit button within THIS form\n    let $btn = $form.find('#btnSubmit');\n    if ($btn.length === 0) {\n      $btn = $form.find('button[type=\"submit\"], input[type=\"submit\"]').first();\n    }\n\n    // Safety: start disabled\n    $btn.prop('disabled', true);\n\n    // 4) Check function \u2014 ONLY equality (remove min-length unless you want it)\n    function check() {\n      const p = ($pass.val() || '').trim();\n      const r = ($re.val()   || '').trim();\n\n      const bothFilled = p.length > 0 && r.length > 0;\n      const match = p === r;\n\n      const ok = bothFilled && match;  // ✅ no min-length here\n      $btn.prop('disabled', !ok);\n\n      const $m = $('#pwMatchMsg');\n      if (!bothFilled) {\n        $m.text('');\n      } else if (!match) {\n        $m.text('Passwords do not match.').css('color', 'red');\n      } else {\n        $m.text('✓ Passwords match.').css('color', 'green');\n      }\n    }\n\n    // 5) Re-check on every change/typing + once on load\n    $pass.add($re).on('input change keyup', check);\n    check();\n\n    // 6) Block submit as a final guard\n    $form.on('submit', function (e) {\n      const p = ($pass.val() || '').trim();\n      const r = ($re.val()   || '').trim();\n      if (!(p && r && p === r)) {\n        e.preventDefault();\n        $('#pwMatchMsg').text('Passwords do not match.').css('color', 'red');\n        return false;\n      }\n    });\n  });\n<\/script>\n"
                    }
                },
