                            "properties": {
                                "requiredSanitize": "",
                                "autoPopulate": "",
                                "label": "",
                                "id": "populateDepartment",
                                "value": "<script>\n    $(document).ready(function () {\n        // Function to populate the department dropdown\n        async function populateDepartments() {\n            // Get the organizationId value using FormUtil\n            const organizationId = FormUtil.getValue(\"organizationId\");\n\n            // Ensure organizationId is not empty\n            if (!organizationId) {\n                console.warn(\"No organizationId selected.\");\n                return;\n            }\n\n            // Construct the API URL and headers\n            const apiUrl = `#request.scheme#://#request.serverName#:#request.serverPort##request.contextPath#/web/json/directory/admin/dept/list?orgId=${organizationId}`;\n            const headers = {\n                \"Authorization\": \"#envVariable.apiAuthorizationJoget#\",\n                \"Content-Type\": \"application/json\"\n            };\n\n            try {\n                // Make the POST request\n                const response = await fetch(apiUrl, {\n                    method: \"POST\",\n                    headers: headers\n                });\n\n                if (!response.ok) {\n                    throw new Error(`API call failed with status: ${response.status}`);\n                }\n\n                // Parse the JSON response\n                const responseData = await response.json();\n\n                // Ensure the response has the expected data structure\n                let departments = responseData.data;\n\n                // Handle the case where 'data' is an object instead of an array\n                if (departments && !Array.isArray(departments)) {\n                    departments = [departments];\n                }\n\n                if (!departments || departments.length === 0) {\n                    console.warn(\"No departments returned from API.\");\n                    return;\n                }\n\n                // Get the department dropdown field\n                const departmentField = FormUtil.getField(\"departmentId\");\n\n                // Clear existing options\n                $(departmentField).empty();\n\n                // Add a placeholder option\n                $(departmentField).append(`<option value=\"\">Select a department<\/option>`);\n\n                // Populate the dropdown with data\n                departments.forEach(dept => {\n                    $(departmentField).append(`<option value=\"${dept.id}\">${dept.name}<\/option>`);\n                });\n\n                console.log(\"Department dropdown updated successfully.\");\n            } catch (error) {\n                console.error(\"Error fetching department data:\", error);\n            }\n        }\n\n        // Bind the function to the 'change' event of the organizationId field\n        const organizationField = FormUtil.getField(\"organizationId\");\n        if (organizationField) {\n            $(organizationField).on(\"change\", populateDepartments);\n        }\n\n        // Optionally call the function on page load\n        populateDepartments();\n    });\n<\/script>"
                            }
