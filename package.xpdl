                        <Tool Id="default_application"/>
                    </Implementation>
                    <Performer>requestor</Performer>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="requestor"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="330,54.65625"/>
