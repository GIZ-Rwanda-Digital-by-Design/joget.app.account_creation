                    </ExtendedAttributes>
                </Activity>
                <Activity Id="CreateUserRecord" Name="Create User Record">
                    <Implementation>
                        <Tool Id="default_application"/>
                    </Implementation>
                    <Performer>Approver</Performer>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="Approver"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="517.989128112793,19.619563112792974"/>
