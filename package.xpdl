                    <Implementation>
                        <Tool Id="default_application"/>
                    </Implementation>
                    <Performer>Approver</Performer>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="Approver"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="600.9791870117188,159.81251350585939"/>
                    </ExtendedAttributes>
